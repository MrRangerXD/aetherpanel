# AETHERPANEL ENVIRONMENT CONFIGURATION EXAMPLE
# Copy or set these environment variables in your server / container deployment environment.

# JWT Secret used for signing admin and user authentication tokens
JWT_SECRET="aether_super_secret_jwt_key_change_me_in_production"

# Port for embedded SFTP server daemon (default: 2022)
SFTP_PORT="2022"

# Initial Super Admin credentials for bootstrap initialization
AETHER_ADMIN_EMAIL="admin@aetherpanel.in"
AETHER_ADMIN_PASSWORD="adminopp"

# Installation Isolation & Identity Keys
AETHER_INSTALLATION_ID="aether_inst_default_01"
AETHER_INSTALLATION_SECRET="aether_inst_secret_default_01"
AETHER_INSTALLATION_PATH="/data/servers"

# Public Panel URL for FQDN resolution and OAuth callbacks
PANEL_URL="http://localhost:3000"

# Playit.gg Tunnel Secret Key for automatic ingress mapping (Optional)
PLAYIT_SECRET_KEY=""

# Database connection URL (for external PostgreSQL/SQLite databases)
DATABASE_URL=""

# Node environment mode
NODE_ENV="development"
